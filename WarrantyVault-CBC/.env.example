# Base URL of the WarrantyVault backend API (no trailing slash needed).
# Defaults to http://localhost:4000/api when unset.
# Only put public values here: anything prefixed VITE_ is shipped to the browser.
# Never put the Supabase keys, the Gemini key or the staff key in this file.
VITE_API_BASE_URL=http://localhost:4000/api
