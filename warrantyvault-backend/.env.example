# --- Server ---
PORT=4000
# Comma-separated list of frontend origins, or * for any (fine for a hackathon)
CORS_ORIGIN=*
# Protects staff-only endpoints. Frontend sends it as header:  x-staff-key: <value>
# Leave empty to disable the check completely.
STAFF_KEY=staff-demo-key
# Service-center timezone offset in minutes (India = 330). Used for "today" and appointment slots.
SERVICE_TZ_OFFSET_MINUTES=330

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the **service_role** key (backend only, never put it in the frontend)
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# "gemini-flash-latest" always points at the current Flash model; pin one if you prefer
GEMINI_MODEL=gemini-flash-latest
